# Database
DATABASE_URL=postgresql://user:password@localhost:5432/freeroom
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freeroom
DB_USER=postgres
DB_PASSWORD=

# Auth
GOOGLE_CLIENT_ID=
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15d
# Optional: only allow Google sign-in from this email domain. Leave blank to allow any.
ALLOWED_EMAIL_DOMAIN=
# Emails that get admin rights when they sign in with Google.
ADMIN_EMAILS=admin@example.com
# Password sign-in: email:bcrypt-hash pairs, comma-separated. Plain passwords are rejected.
# Create a hash with: cd server && npm run hash-password
ADMIN_USERS=admin@example.com:$2a$12$replace-with-the-output-of-npm-run-hash-password

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Campus settings
CAMPUS_TIMEZONE=Asia/Kolkata
# Default buffer until an admin saves one in Room chaining settings.
BUFFER_MINUTES=0
